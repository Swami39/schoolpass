# Copy to .env for local development. Never commit real secrets.

APP_ENV=local
APP_NAME=schoolpass
LOG_LEVEL=INFO

# Runtime role — NOBYPASSRLS. Not the migrator.
DATABASE_URL=postgresql+asyncpg://schoolpass_app:app_dev_only@localhost:5432/schoolpass

# Alembic / bootstrap only. Never used by the API process.
DATABASE_URL_MIGRATOR=postgresql+psycopg://schoolpass_migrator:migrator_dev_only@localhost:5432/schoolpass

REDIS_URL=redis://localhost:6379/0

# RSA PEMs (use: python scripts/gen_dev_keys.py). Gitignored.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30

# Must remain false in staging/production. Enables Redis OTP capture for local/test only.
OTP_DEV_ALLOW=true

# Encrypts MFA secrets at rest. Override locally; never use the default in production.
SECRET_APP_KEY=dev-only-not-for-production

BLOB_LOCAL_ROOT=.data/blobs
SERVICE_BUS_MODE=local
