# Copy to .env and fill in. Used by scripts/run_api_lan.sh and by
# docker compose (infra/docker/compose.yaml) via env_file.
APP_ENV=local
LOG_LEVEL=INFO

# Local (non-Docker) URLs. The compose file overrides these with the
# container service hostnames for the api/worker services.
DATABASE_URL=postgresql+asyncpg://schoolpass_app:app_dev_only@localhost:5432/schoolpass
DATABASE_URL_MIGRATOR=postgresql+psycopg://schoolpass_migrator:migrator_dev_only@localhost:5432/schoolpass
REDIS_URL=redis://localhost:6379/0

# Generate with: python scripts/gen_dev_keys.py
# Paste the full PEM output, keeping the \n escapes inside the quotes.
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nPASTE_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----\n"

SECRET_APP_KEY=dev-only-change-me
DIRECTORY_BOOTSTRAP_PASSWORD=Demo-Local-Only-2026
OTP_DEV_ALLOW=true
